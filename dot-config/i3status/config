# i3status - blush blocks on a glass bar. icons are Font Awesome 7 Free Solid via pango.
general {
        output_format = "i3bar"
        colors = false
        markup = pango
        interval = 5
        color_good = '#ffd1dc'
        color_degraded = '#ffb86b'
        color_bad = '#e0457b'
}

order += "wireless wlp0s20f3"
order += "load"
order += "cpu_temperature 0"
order += "disk /"
order += "volume master"
order += "battery 0"
order += "tztime local"

wireless wlp0s20f3 {
        format_up   = "<span background='#ffe4ec' foreground='#4a1a2c'> <span font_family='Font Awesome 7 Free Solid'></span>  %essid </span>"
        format_down = "<span background='#ffe4ec' foreground='#8a5a6c'> <span font_family='Font Awesome 7 Free Solid'></span>  off </span>"
}
load {
        format = "<span background='#ffd1dc' foreground='#4a1a2c'> <span font_family='Font Awesome 7 Free Solid'></span>  %1min </span>"
        max_threshold = 8
}
cpu_temperature 0 {
        format = "<span background='#ffc2d1' foreground='#4a1a2c'> <span font_family='Font Awesome 7 Free Solid'></span>  %degrees° </span>"
        path = "/sys/devices/platform/coretemp.0/hwmon/hwmon*/temp1_input"
        max_threshold = 85
}
disk "/" {
        format = "<span background='#ffb3c6' foreground='#4a1a2c'> <span font_family='Font Awesome 7 Free Solid'></span>  %free </span>"
}
volume master {
        format       = "<span background='#ff9ebb' foreground='#4a1a2c'> <span font_family='Font Awesome 7 Free Solid'></span>  %volume </span>"
        format_muted = "<span background='#ff9ebb' foreground='#8a5a6c'> <span font_family='Font Awesome 7 Free Solid'></span>  muted </span>"
        device = "default"
        mixer = "Master"
        mixer_idx = 0
}
battery 0 {
        format      = "<span background='#ff8fab' foreground='#4a1a2c'> %status %percentage %remaining </span>"
        format_down = "<span background='#ff8fab' foreground='#4a1a2c'> no battery </span>"
        status_chr  = "<span font_family='Font Awesome 7 Free Solid'></span>"
        status_bat  = "<span font_family='Font Awesome 7 Free Solid'></span>"
        status_unk  = "<span font_family='Font Awesome 7 Free Solid'></span>"
        status_full = "<span font_family='Font Awesome 7 Free Solid'></span>"
        status_idle = "<span font_family='Font Awesome 7 Free Solid'></span>"
        path = "/sys/class/power_supply/BAT0/uevent"
        last_full_capacity = true
        integer_battery_capacity = true
        hide_seconds = true
        low_threshold = 15
        threshold_type = percentage
}
tztime local {
        format = "<span background='#ffe4ec' foreground='#4a1a2c'> <span font_family='Font Awesome 7 Free Solid'></span>  %a %d  %H:%M </span>"
}
