/* blush - rofi theme to match dunst + lock. needs a compositor for the glass (picom blurs class Rofi). */
* {
  bg:        #fff0f54d;
  bg-alt:    #ffe4ec8c;
  fg:        #4a1a2c;
  fg-dim:    #8a5a6c;
  pink:      #ff8fab;
  pink-deep: #e0457b;
  frame:     #ffb3c6d9;
  background-color: transparent;
  text-color: @fg;
  font: "Operator Mono 12";
}
window   { background-color: @bg; border: 2px; border-color: @frame; border-radius: 14px; width: 36%; padding: 14px; location: center; }
mainbox  { spacing: 10px; }
inputbar { background-color: @bg-alt; border-radius: 10px; padding: 10px 14px; spacing: 8px; children: [ prompt, entry ]; }
prompt   { text-color: @pink-deep; }
entry    { placeholder: "search ♡"; placeholder-color: @fg-dim; cursor: text; }
listview { lines: 8; columns: 1; spacing: 4px; scrollbar: false; fixed-height: false; }
element  { padding: 8px 12px; border-radius: 10px; spacing: 10px; }
element normal.normal, element alternate.normal { background-color: transparent; }
element selected.normal { background-color: @pink; text-color: #ffffff; }
element-icon { size: 1.4em; background-color: transparent; }
element-text { vertical-align: 0.5; background-color: transparent; text-color: inherit; }
message, textbox { background-color: @bg-alt; border-radius: 10px; padding: 8px 12px; }
