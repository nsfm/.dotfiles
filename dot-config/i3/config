exec_always --no-startup-id autotiling

# set modifier
set $super Mod4
set $alt Mod1

floating_minimum_size 50x50
floating_maximum_size 2000x2000

# set font
font pango: Operator Mono Light 8

# Mod + drag to float windows
floating_modifier $super
# Need to set xrandr settings before i3 starts to support rotated displays
exec --no-startup-id autorandr -c
# Wallpaper
exec --no-startup-id feh --bg-fill ~/.wallpapers/bg.png
#exec --no-startup-id yarn --cwd ~/.scripts/wallpaper_generator start
# Synchronize clipboards
exec --no-startup-id autocutsel -fork &
exec --no-startup-id autocutsel -selection PRIMARY -fork &
# Something to do with xresources
exec --no-startup-id xsettingsd &
# Compositor
# exec --no-startup-id xcompmgr &   (retired 2026-10-30; picom below)
exec --no-startup-id picom -b
# Notification Server
exec --no-startup-id dunst
# Volume applet
# Bluetooth applet
exec --no-startup-id blueman-applet &
# Wifit applet
exec --no-startup-id nm-applet &
# USB auto mount
exec --no-startup-id udiskie &
# File manager in background for quick launch / automount
exec --no-startup-id pcmanfm -d &
# Lock on screensaver, suspend
exec --no-startup-id xss-lock --transfer-sleep-lock -n ~/.scripts/dim-screen.sh -- ~/.scripts/lock.sh &
# dim at 9:00 idle, lock at 10:00, panel off at 11:00
exec --no-startup-id xset s 540 60 dpms 0 0 660
# Power saving
#exec --no-startup-id rfkill block bluetooth


bindsym $super+Shift+Return exec kitty --hold -1
bindsym $super+Shift+v exec pavucontrol
bindsym $super+p exec i3-dmenu-desktop --dmenu="dmenu -i -fn 'Operator Mono Bold:size=8'"
bindsym $super+Shift+p exec --no-startup-id rofi -show drun
bindsym Print exec scrot 'screenshot_%a-%d%b%y_%H.%M.png' -e 'viewnior $f'
bindsym $super+l exec ~/.scripts/lock.sh

# Volume / mic hotkeys: pipewire via wpctl, dunst osd (~/.scripts/volume.sh)
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.scripts/volume.sh up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.scripts/volume.sh down
bindsym XF86AudioMute exec --no-startup-id ~/.scripts/volume.sh mute
bindsym XF86AudioMicMute exec --no-startup-id ~/.scripts/volume.sh micmute

# dunst keys (the old [shortcuts] section in dunstrc stopped working in dunst 1.10)
bindsym $super+Escape exec --no-startup-id dunstctl close
bindsym $super+Shift+Escape exec --no-startup-id dunstctl close-all
bindsym $super+grave exec --no-startup-id dunstctl history-pop
bindsym $super+Shift+grave exec --no-startup-id dunstctl context

# Adjust brightness from hotkeys.
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.scripts/brightness.sh up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.scripts/brightness.sh down

# kill focused window
bindsym $super+x kill

# change focus
bindsym $super+Left focus left
bindsym $super+Down focus down
bindsym $super+Up focus up
bindsym $super+Right focus right

# move focused window
bindsym $super+Shift+Left move left
bindsym $super+Shift+Down move down
bindsym $super+Shift+Up move up
bindsym $super+Shift+Right move right

# split in horizontal orientation
bindsym $super+h split h

# split in vertical orientation
bindsym $super+v split v

# enter fullscreen mode for the focused container
bindsym $super+f fullscreen toggle

# change container layout split
bindsym $super+s layout toggle split

# toggle tiling / floating
bindsym $super+space floating toggle

# change focus between tiling / floating windows
bindsym $super+Shift+space focus mode_toggle

# switch to workspace
bindsym $alt+Control+Right workspace next
bindsym $alt+Control+Left workspace prev
bindsym $super+1 workspace 1
bindsym $super+2 workspace 2
bindsym $super+3 workspace 3
bindsym $super+4 workspace 4
bindsym $super+5 workspace 5
bindsym $super+6 workspace 6
bindsym $super+7 workspace 7
bindsym $super+8 workspace 8
bindsym $super+9 workspace 9

# move focused container to workspace
bindsym $super+Shift+1 move container to workspace 1
bindsym $super+Shift+2 move container to workspace 2
bindsym $super+Shift+3 move container to workspace 3
bindsym $super+Shift+4 move container to workspace 4
bindsym $super+Shift+5 move container to workspace 5
bindsym $super+Shift+6 move container to workspace 6
bindsym $super+Shift+7 move container to workspace 7
bindsym $super+Shift+8 move container to workspace 8
bindsym $super+Shift+9 move container to workspace 9

# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $super+Shift+r restart

# exit i3
bindsym $super+q exec "i3-nagbar -t warning -m 'Really, exit?' -b 'Yes' 'i3-msg exit'"

# resize window (you can also use the mouse for that)
mode "resize" {
        bindsym Left resize shrink width 5 px or 5 ppt
        bindsym Down resize grow height 5 px or 5 ppt
        bindsym Up resize shrink height 5 px or 5 ppt
        bindsym Right resize grow width 5 px or 5 ppt
        bindsym Return mode "default"
}
bindsym $super+r mode "resize"

# panel
bar {
	i3bar_command i3bar --transparency
	font pango:Operator Mono Light 9
	colors {
        background #1b1f2766
        statusline #ffe4ec
        separator  #ffb3c680

		# colour of border, background, and text
        focused_workspace	#ff8fab	#ff8fab	#4a1a2c
        active_workspace	#ffb3c6	#ffb3c640	#ffe4ec
        inactive_workspace	#00000000	#00000000	#d9a7b6
        urgent_workspace	#e0457b	#e0457b	#fff0f5
    }
        status_command i3status
        mode hide
        hidden_state hide
        modifier $super
}

# window rules, you can find the window class using xprop
for_window [class=".*"] border pixel 0
for_window [class=URxvt|Pavucontrol] focus
#for_window [class=kitty] border_radius 15

#border_radius 15

# colour of border, background, text, indicator, and child_border
client.focused			#bf616a #2f343f #d8dee8 #bf616a #d8dee8
client.focused_inactive	#2f343f #2f343f #d8dee8 #2f343f #2f343f
client.unfocused		#2f343f #2f343f #d8dee8 #2f343f #2f343f
client.urgent			#2f343f #2f343f #d8dee8 #2f343f #2f343f
client.placeholder		#2f343f #2f343f #d8dee8 #2f343f #2f343f
client.background		#2f343f

