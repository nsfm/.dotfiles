# dunst 1.13 - cutesy light pink. scale=0 reads Xft.dpi (192 on this panel).
[global]
    monitor = 0
    follow = mouse
    width = (280, 440)
    height = (0, 240)
    origin = top-right
    offset = (20, 20)
    scale = 0
    gap_size = 8
    notification_limit = 6
    indicate_hidden = yes
    separator_height = 0
    padding = 14
    horizontal_padding = 18
    text_icon_padding = 12
    frame_width = 2
    frame_color = "#ffb3c6d9"
    corner_radius = 14
    sort = yes
    idle_threshold = 120
    font = Operator Mono Light 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = end
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = yes
    show_indicators = no
    enable_recursive_icon_lookup = true
    icon_theme = "Papirus-Dark, Papirus, Adwaita, gnome"
    icon_position = left
    min_icon_size = 22
    max_icon_size = 36
    sticky_history = yes
    history_length = 20
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all
    # progress bars (volume / brightness / battery)
    progress_bar = true
    progress_bar_height = 9
    progress_bar_frame_width = 0
    progress_bar_min_width = 220
    progress_bar_max_width = 400
    progress_bar_corner_radius = 4

[urgency_low]
    background = "#fff0f54d"
    foreground = "#8a5a6c"
    frame_color = "#ffd1dcd9"
    highlight = "#ffa6c1"
    timeout = 2

[urgency_normal]
    background = "#ffe4ec4d"
    foreground = "#5a2a3c"
    frame_color = "#ff9ebbd9"
    highlight = "#ff8fab"
    timeout = 5

[urgency_critical]
    background = "#ffd6e08c"
    foreground = "#4a1a2c"
    frame_color = "#e0457b"
    highlight = "#e0457b"
    timeout = 0

# osd cards: volume, brightness. short, never in history, teal bar.
[osd]
    appname = "volume|brightness"
    history_ignore = yes
    timeout = 1
    background = "#fff0f54d"
    foreground = "#7a3a52"
    frame_color = "#ffc2d1d9"
    highlight = "#ff8fab"
    format = "<b>%s</b>"

[osd-muted]
    appname = "volume"
    summary = "*muted*"
    highlight = "#d9a7b6"
    frame_color = "#e8c7d1"
